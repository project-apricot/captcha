<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>ASP.NET Core integration for ApricotFramework.Captcha: a guard that reads the challenge token from the request headers, a [ValidateCaptcha] action filter that enforces requirements per endpoint, and configuration-bound providers whose secrets are validated at startup.</Description>
    <PackageTags>captcha;recaptcha;hcaptcha;turnstile;aspnetcore;dependencyinjection</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ApricotFramework.Captcha/ApricotFramework.Captcha.csproj" />
  </ItemGroup>

</Project>
